# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/mamoa-mall for a local MongoDB)
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mamoa-mall

# Long random string used to sign login tokens
JWT_SECRET_KEY=change-me-to-a-long-random-string

PORT=3000

# Where the React app runs (for CORS)
CLIENT_URL=http://localhost:5173

# Public URL of this API, used to build links to uploaded images
SERVER_URL=http://localhost:3000

# true = new stores open immediately after paying; false = mall admin must approve them
AUTO_APPROVE_STORES=false

# Mall admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@mamoa.co.za
SEED_ADMIN_PASSWORD=Admin123!
